# Configure these as runtime environment variables. Never ship secrets in Unity.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=candycraze
GOOGLE_CLIENT_ID=your-game-server-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-client-secret
PORT=3000
# Google Play Developer API service account; server only, never in Unity.
PLAY_SERVICE_ACCOUNT_EMAIL=
PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional: actual trusted reverse-proxy IPs/CIDRs, comma-separated; never '*'/true.
# TRUSTED_PROXY_CIDRS=
